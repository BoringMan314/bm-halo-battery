# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# PyInstaller (scripts/build_exe.bat)
build/
*.spec

# Root-level build output, shortcuts, and release archives
/dist/
/*.url
/*.zip

# Diagnostics and logs (written to %APPDATA%\HaloBattery, but just in case)
*.log
diagnostics.txt

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Generated exe icon (tools/make_icon.py)
halo.ico

# release notes extracted by the workflow
release_notes.md

# Generated version resource (tools/make_version.py)
version_info.txt
AGENTS.md
/agents_memory

# Portable mode (portable.txt): the app keeps its data next to itself
portable.txt
config.json
history.json
status.json
notification_icon.png
